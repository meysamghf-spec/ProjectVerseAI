# Copy to .env and fill in. Never commit .env. See DEPLOY.md.
# Generate secrets with:  openssl rand -base64 36 | tr -d '/+=@:?#'

# ---------------------------------------------------------------------------
# Production (docker-compose.yml behind the server's shared Caddy)
# ---------------------------------------------------------------------------
# Public hostname only, no https:// and no path.
SITE_ADDRESS=
# Bundled database password, at least 16 characters, without @ : / ? #
POSTGRES_PASSWORD=
# First administrator. Created once when the users table is empty; remove the password afterwards.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
# Optional: move projects created under the old shared API key owner (e.g. hosted-owner) to that admin.
LEGACY_OWNER_ID=
SESSION_HOURS=12
# Interface language for first-time visitors: en (default) or fa.
DEFAULT_LOCALE=en
# External Docker network shared with Caddy.
PROXY_NETWORK=caddy
# Shared PostgreSQL instead (docker-compose.shared-db.yml):
# DATABASE_URL=postgresql+psycopg://projectverse:REPLACE_WITH_A_LONG_PASSWORD@postgres:5432/projectverse
# SHARED_DB_NETWORK=postgres

# Optional mirrors for servers in Iran where Docker Hub, PyPI or npm are blocked or slow.
POSTGRES_IMAGE=
PYTHON_IMAGE=
NODE_IMAGE=
PIP_INDEX_URL=
NPM_REGISTRY=

# Optional OpenAI-compatible extractor. Empty keeps the built-in deterministic parser.
LLM_PROVIDER=deterministic
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ---------------------------------------------------------------------------
# Local development (backend run directly, or docker-compose.dev.yml)
# ---------------------------------------------------------------------------
# development | production
APP_ENV=development
# development: shared local owner id, no sign-in. accounts: real users (required in production).
# api_key: legacy single shared key (development/testing only; production rejects it).
AUTH_MODE=development
DEV_OWNER_ID=dev-user
API_KEY=
API_OWNER_ID=api-owner
DATABASE_URL=sqlite:///./projectverse.db
CORS_ORIGINS=http://localhost:3000
# Leave empty: secure cookies are on in production and off in development.
# COOKIE_SECURE=
ENGINE_VERSION=1.0.0
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
# Browser-facing API origin for local development. Production builds use same-origin ("").
NEXT_PUBLIC_API_URL=http://localhost:8000
