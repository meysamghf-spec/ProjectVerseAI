# Copy to .env for local overrides. Do not commit real secrets.

# development | production
APP_ENV=development

# development uses DEV_OWNER_ID and does not require an API key.
# api_key requires API_KEY and ignores the X-Owner-Id header.
AUTH_MODE=development
DEV_OWNER_ID=dev-user
API_KEY=
API_OWNER_ID=api-owner

# sqlite for local development and tests; postgres URL for Docker Compose.
DATABASE_URL=sqlite:///./projectverse.db

CORS_ORIGINS=http://localhost:3000
ENGINE_VERSION=1.0.0

# deterministic | openai_compatible
# Leave the key empty to stay on the deterministic extractor.
LLM_PROVIDER=deterministic
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2

# Browser-facing API origin. In Docker Compose the browser still uses the published port.
NEXT_PUBLIC_API_URL=http://localhost:8000
